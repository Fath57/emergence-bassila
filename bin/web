#!/usr/bin/env bash
# Web process entry point.
# Runs on every web container boot (fresh container per deploy / restart).
#
# Responsibilities:
#   1. Create public/storage symlink so user uploads under the mounted
#      volume (storage/app/public) become reachable via HTTP. Idempotent.
#   2. exec heroku-php-nginx to serve public/ with the Laravel nginx rewrite.
#
# Laravel cache commands (config:cache, route:cache, view:cache, event:cache)
# are intentionally NOT run here — they are a boot-time optimization, not a
# correctness requirement. Add them here if cold-start latency becomes an
# issue.

set -euo pipefail

echo "-----> web.sh: linking public/storage -> storage/app/public"
php artisan storage:link

echo "-----> web.sh: starting heroku-php-nginx"
exec vendor/bin/heroku-php-nginx -C nginx_app.conf public/
